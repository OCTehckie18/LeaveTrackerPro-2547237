# Copy to backend/.env for local development. Never commit the real .env.
APP_ENV=local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/leavetracker
LOG_LEVEL=INFO
ORG_TZ=Asia/Kolkata
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
DEMO_MODE=false
